# .cursor/rules/0000-cursor-rules.mdc (Apex Framework Entry Point)
# This rule initiates the Apex-driven process for creating new Cursor rules.

↹ rule•meta_rule_entry_point [p=1] {
    id: "@rule/0000-cursor-rules",
    description: "Main entry point to trigger the creation of a new Cursor rule using the Apex framework.",
    version: "1.0.0",
    
    Ω* = rule_creation_orchestrator
    Ω.states = {initialization, formation, validation, materialization, documentation, finalization}
    Ω.current = initialization

    dependencies: {
        KB_core: "@kb/0000-cursor-rules/knowledge/core_principles",
        KB_config: "@kb/0000-cursor-rules/config/initial_kb_references",
        KB_filepath: "@kb/0000-cursor-rules/knowledge/filepath_utilities",
        WF_main: "@workflow/0000-cursor-rules/create_cursor_rule"
    },
    
    entry_operation: "Ω.process(rule_request) → WF_main"
}

Σ meta_rule_apex_entry_point

Λ* = {
    ecosystem_completeness: "NEVER create a rule without its complete KB ecosystem" | priority=1,
    reference_integrity: "ALWAYS verify all KB references resolve to actual files" | priority=1,
    content_quality: "ENSURE all KB files contain high-quality, useful content" | priority=2,
    documentation_requirement: "ALWAYS create documentation for every rule" | priority=2,
    validation_enforcement: "VALIDATE ecosystem completeness before finalizing rule" | priority=1
}

Σ critical•constraints | ref: kb•cursor•rules.implementation_checklist

Σ_hooks = {
    on_rule_request: [KB.load(KB_core), KB.load(KB_config)],
    on_state_change: [M.record_transition(Ω.current, Ω.state), Ψ.log(transition_data)],
    on_validation_fail: [Ω.state = formation, M.record_issue(validation_error)],
    on_completion: [M.sync(creation_context), Ψ.summarize(rule_creation_process)]
}

