# Operation: Implement Core Rule File (Version 1.0.2)
# Generates the core .mdc rule file content.

↹ operation•implement_core_rule_file [p=1] {
    id: "@op/0000-cursor-rules/implement_core_rule_file",
    version: "1.0.2",
    description: "Generates the core .mdc rule file using LLM with refinement capabilities",
    
    OP_implement = {
        type: "rule_file_generation",
        function: "generate_semantic_mdc",
        cognitive_load: "very_high"
    }
    
    input: {
        rule_request: "Original rule request with details",
        strategy: "Strategy configuration from previous phase",
        kb_artifacts: "List of created KB artifacts for context",
        rule_base_path: "Base path for the rule file (e.g., .cursor/rules/)",
        prompt_kb_path: "@kb/0000-cursor-rules/prompts/semantic_mdc_generator_prompt"
    },

    output: {
        created_mdc_artifact: {
            artifact_type: "rule_mdc",
            file_path: "Path to the created rule file",
            status: "enum(Success, SuccessWithStub, GenerationFailed, SuccessAfterRefinement)",
            content_hash: "Hash of the content (optional)"
        }
    },
    
    Ω_process = {
        # Stage 1: Preparation
        prepare: {
            action: "KB•load_content",
            input: "input.prompt_kb_path",
            output: "prompt_template",
            
            action_path: {
                derive_filepath: {
                    action: "Ω•filepath.construct",
                    input: {
                        base: "input.rule_base_path",
                        id: "input.rule_request.rule_id",
                        ext: ".mdc"
                    },
                    output: "target_filepath"
                }
            }
        },
        
        # Stage 2: Initial generation
        generate: {
            action: "LLM•call",
            template: "prompt_template",
            input: {
                rule_request: "input.rule_request",
                strategy: "input.strategy",
                kb_artifacts: "input.kb_artifacts"
            },
            output: {
                content: "initial_mdc_content",
                quality: "generation_quality"
            }
        },
        
        # Stage 3: Quality evaluation
        evaluate: {
            action: "Λ.evaluate_mdc_quality",
            input: {
                content: "initial_mdc_content",
                assessment: "generation_quality"
            },
            output: {
                is_valid: "mdc_valid",
                issues: "detected_issues"
            }
        },
        
        # Stage 4: Conditional refinement
        refine: {
            condition: "!mdc_valid",
            action: "LLM•call",
            contract: "LLM_mdc_refiner",
            input: {
                rule_request: "input.rule_request",
                initial_mdc: "initial_mdc_content",
                issues: "detected_issues"
            },
            output: "refined_mdc_content"
        },
        
        # Stage 5: Finalization
        finalize: {
            action: "Ω•select_content",
            input: {
                initial: "initial_mdc_content",
                refined: "refined_mdc_content",
                use_refined: "!mdc_valid"
            },
            output: {
                content: "final_mdc_content",
                status: "final_status"
            },
            
            action_path: {
                save: {
                    action: "Ω•filesystem.write",
                    input: {
                        path: "target_filepath",
                        content: "final_mdc_content"
                    },
                    output: "write_status",
                    error_handling: "Λ.handle_filesystem_error(write_status)"
                },
                
                journal: {
                    action: "M.record_artifact",
                    input: {
                        type: "rule_mdc",
                        path: "target_filepath",
                        status: "final_status",
                        meta: {
                            content_hash: "Ω•hash(final_mdc_content)"
                        }
                    },
                    output: "created_mdc_artifact"
                }
            }
        }
    },
    
    dependencies: {
        KB_prompt: "@kb/0000-cursor-rules/prompts/semantic_mdc_generator_prompt",
