# Operation: Validate Ecosystem (Version 1.0.1)
# Validates the created rule ecosystem against the target manifest.

↹ operation•validate_ecosystem [p=1] {
    id: "@op/0000-cursor-rules/validate_ecosystem",
    version: "1.0.1",
    description: "Validates the artifacts recorded in the actual_artifact_journal against the target_artifact_manifest. Checks for existence, naming conventions, and potentially basic content presence or key sections coverage.",
    author: "ApexSystemSimulation",

    input_schema: {
        validation_config: {
            type: "object",
            properties: {
                target_manifest: { type: "object", description: "The target_artifact_manifest generated by adapt_workflow_strategy." },
                actual_journal: { type: "array", description: "The list of actual_artifact_journal entries." },
                validation_depth: { type: "enum", values: ["shallow", "deep"], default: "shallow", description: "Shallow: existence & naming. Deep: content checks." }
            },
            required: ["target_manifest", "actual_journal"]
        }
    },

    output_schema: {
        validation_report_obj: {
            type: "object",
            properties: {
                overall_status: { type: "enum", values: ["Success", "CompletedWithWarnings", "Failed"] },
                mismatches: { 
                    type: "array", 
                    items: { 
                        type: "object", 
                        properties: { 
                            expected_artifact: "string", 
                            actual_artifact: "string", 
                            issue_type: "string", 
                            details: "string" 
                        } 
                    },
                    optional: true 
                },
                summary_text: { type: "string" }
            },
            required: ["overall_status", "summary_text"]
        }
    },

    steps: [
        {
            step_id: "perform_validation",
            description: "Compare manifest against journal based on validation depth.",
            logic: "Ω•internal/compare_manifest_to_journal(input.validation_config.target_manifest, input.validation_config.actual_journal, input.validation_config.validation_depth)",
            outputs: ["validation_report_obj"]
        }
    ]
}
Σ operation_specification validate_ecosystem_simulation
