# Operation: Validate Ecosystem (Version 1.0.1)
# Validates the created rule ecosystem against the target manifest.

↹ operation•validate_ecosystem [p=1] {
    id: "@op/0000-cursor-rules/validate_ecosystem",
    version: "1.0.1",
    description: "Validates created artifacts against target manifest with configurable depth",
    
    OP_validate = {
        type: "ecosystem_validation",
        function: "verify_completeness_and_integrity",
        cognitive_load: "medium"
    }
    
    input: {
        target_manifest: "Manifest specifying expected artifacts from adapt_workflow_strategy",
        actual_journal: "List of actual artifact journal entries from creation phases",
        validation_depth: "enum(shallow, deep) - Shallow: existence & naming; Deep: content checks"
    },

    output: {
        validation_report: {
            overall_status: "enum(Success, CompletedWithWarnings, Failed)",
            mismatches: [
                {
                    expected_artifact: "Expected artifact specification",
                    actual_artifact: "Actual artifact or null if missing",
                    issue_type: "Type of validation issue detected",
                    details: "Detailed description of the issue"
                }
            ],
            summary_text: "Human-readable validation summary"
        }
    },
    
    Ω_process = {
        # Primary validation flow with depth-based branching
        validate: {
            action: "Λ.validate_against_manifest",
            input: {
                manifest: "input.target_manifest",
                journal: "input.actual_journal",
                depth: "input.validation_depth"
            },
            output: {
                status: "validation_status",
                issues: "detected_issues"
            },
            
            # Distinguish between shallow and deep validation paths
            paths: {
                shallow: {
                    condition: "input.validation_depth === 'shallow'",
                    action: "Λ.validate_existence_and_naming",
                    input: {
                        manifest: "input.target_manifest",
                        journal: "input.actual_journal"
                    },
                    output: "shallow_validation"
                },
                
                deep: {
                    condition: "input.validation_depth === 'deep'",
                    action: "Λ.validate_content_integrity",
                    input: {
                        manifest: "input.target_manifest",
                        journal: "input.actual_journal", 
                        validate_kb_content: true,
                        validate_rule_structure: true
                    },
                    output: "deep_validation"
                }
            }
        },
        
        # Consolidation of validation results
        consolidate: {
            action: "Λ.consolidate_validation_results",
            input: {
                shallow_results: "shallow_validation",
                deep_results: "deep_validation",
                depth: "input.validation_depth"
            },
            output: "consolidated_results"
        },
        
        # Final report generation
        generate_report: {
            action: "M.generate_validation_report",
            input: {
                results: "consolidated_results",
                manifest: "input.target_manifest",
                journal: "input.actual_journal"
            },
            output: "validation_report"
        }
    },
    
    dependencies: {
        KB_validation_rules: "@kb/0000-cursor-rules/specs/validation_rules"
    },
    
    Ψ_trace = {
        validation_started: "M.record_validation_start(input.validation_depth)",
        issues_detected: "M.record_validation_issues(detected_issues)",
        validation_complete: "Ψ.log(validation_status)"
    }
}

