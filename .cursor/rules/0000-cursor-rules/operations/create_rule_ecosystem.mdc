# Operation: Create Rule Ecosystem (Version 1.0.1)
# Creates the Knowledge Base (KB) ecosystem for a new rule.

↹ operation•create_rule_ecosystem [p=1] {
    id: "@op/0000-cursor-rules/create_rule_ecosystem",
    version: "1.0.1",
    description: "Creates the knowledge base ecosystem for a new rule based on target manifest",
    
    OP_ecosystem = {
        type: "kb_ecosystem_creation",
        function: "materialize_knowledge_artifacts",
        cognitive_load: "high"
    }
    
    input: {
        rule_request: "Original rule request details",
        strategy: "Overall strategy guiding creation",
        kb_manifest: "Array of KB files specification from the target manifest"
    },

    output: {
        created_kb_artifacts: [
            {
                artifact_type: "Type identifier (kb_example, kb_spec, kb_prompt, etc.)",
                file_path: "Full path to the created file",
                status: "enum(Success, SuccessWithStub, GenerationFailed)",
                content_hash: "Hash/checksum of the content (optional)"
            }
        ]
    },
    
    Ω_process = {
        # Primary process flow: iterate over KB entries and generate content
        iterate_manifest: {
            action: "Ω•foreach(kb_entry IN input.kb_manifest)",
            process: {
                generate: {
                    action: "LLM•call",
                    contract: "LLM_kb_generator",
                    input: {
                        rule_request: "input.rule_request",
                        kb_purpose: "kb_entry.purpose",
                        key_points: "kb_entry.key_content_points",
                        template_context: "input.strategy.template_context || {}"
                    },
                    output: {
                        content: "generated_content",
                        status: "generation_status"
                    }
                },
                
                save: {
                    action: "Ω•filesystem.write",
                    input: {
                        path: "kb_entry.target_path", 
                        content: "generated_content"
                    },
                    output: "file_status",
                    error_handling: "Λ.handle_filesystem_error(file_status)"
                },
                
                journal: {
                    action: "M.record_artifact",
                    input: {
                        type: "M.derive_kb_type(kb_entry.name_pattern)",
                        path: "kb_entry.target_path",
                        status: "generation_status",
                        meta: {
                            purpose: "kb_entry.purpose",
                            content_hash: "Ω•hash(generated_content)"
                        }
                    },
                    output: "kb_journal_entry",
                    aggregate: "M.append_to(created_kb_artifacts)"
                }
            }
        },
        
        # Final validation of the created artifacts
        validate: {
            action: "Λ.validate_ecosystem",
            input: {
                artifacts: "created_kb_artifacts",
                expected: "input.kb_manifest"
            },
            on_failure: "M.record_validation_error(validation_result)"
        }
    },
    
    dependencies: {
        LLM_kb_generator: "@llm_contract/0000-cursor-rules/kb_content_generator",
        KB_templates: "@kb/0000-cursor-rules/templates/kb_templates",
        KB_filepath: "@kb/0000-cursor-rules/knowledge/filepath_utilities"
    },
    
    Ψ_trace = {
        ecosystem_created: "M.record_creation_metrics(created_kb_artifacts)",
        kb_content_generated: "Ψ.log_generation_stats(created_kb_artifacts)"
    }
}

