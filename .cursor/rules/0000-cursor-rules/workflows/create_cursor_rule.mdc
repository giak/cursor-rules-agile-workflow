# Workflow Blueprint: Create Cursor Rule (Version 1.0.1)
# Part of the Apex Solution Framework
# This workflow orchestrates the end-to-end process of creating a new Cursor rule

↹ workflow•create_cursor_rule [p=1] {
    id: "@workflow/0000-cursor-rules/create_cursor_rule",
    description: "Orchestrates creating a Cursor rule with complete ecosystem from assessment through validation",
    version: "1.0.1",

    Ω* = rule_creation_process
    Ω.states = {
        assessment,      # Phase 1: Initial assessment 
        clarification,   # Phase 2: Optional user clarification
        ecosystem,       # Phase 3: KB ecosystem creation
        implementation,  # Phase 4: Core rule implementation
        documentation,   # Phase 5: Documentation generation
        validation,      # Phase 6: Validation against manifest
        finalization     # Phase 7: Finalization and reporting
    }
    Ω.current = assessment
    
    M* = {
        artifact_journal: [],    # Records all created artifacts
        strategy: null,          # Workflow strategy configuration
        manifest: null           # Target artifact manifest
    }
    
    input: { 
        rule_request: {
            description: "Detailed description of the rule to be created",
            goal: "The primary objective of the rule",
            context: "Contextual information relevant to the rule's application",
            dependencies: "Known dependencies (optional)",
            target_audience: "Intended users (optional)",
            rule_id: "Proposed rule ID (e.g., 0002-hello-world-semantic)"
        }
    },

    Ω.process = {
        # Phase 1: Assessment & Strategy Generation
        assessment: {
            OP_assess: "@op/0000-cursor-rules/assess_complexity",
            input: { "rule_request": "input.rule_request" },
            output: "assessment_data",
            
            OP_strategize: "@op/0000-cursor-rules/adapt_workflow_strategy",
            input: { 
                "assessment_result": "assessment_data",
                "initial_kb_references_path": "KB_config"
            },
            output: "strategy_obj",
            
            on_complete: [
                "M.strategy = strategy_obj.strategy_config",
                "M.manifest = strategy_obj.strategy_config.target_artifact_manifest",
                "Ω.transition(clarification, IF(M.strategy.trigger_user_clarification, true, false))"
            ]
        },
        
        # Phase 2: Optional User Clarification
        clarification: {
            OP_clarify: "@op/0000-cursor-rules/request_clarification",
            input: {
                "justification": "M.strategy.additional_guidance",
                "confidence": "assessment_data.confidence.justification",
                "strategy": "M.strategy",
                "prompt": "Des ambiguïtés ont été détectées. Pouvez-vous fournir des clarifications?"
            },
            output: "user_feedback",
            
            on_complete: [
                "M.strategy = user_feedback.adjusted_strategy || M.strategy", 
                "Ω.transition(ecosystem)"
            ]
        },
        
        # Phase 3: Ecosystem Creation
        ecosystem: {
            OP_create_ecosystem: "@op/0000-cursor-rules/create_rule_ecosystem",
            input: {
                "rule_request": "input.rule_request",
                "strategy": "M.strategy",
                "kb_manifest": "M.manifest.knowledge_base_files"
            },
            output: "ecosystem_result",
            
            on_complete: [
                "M.artifact_journal = M.artifact_journal.concat(ecosystem_result.created_kb_artifacts)", 
                "Ω.transition(implementation)"
            ]
        },
        
        # Phase 4: Core Rule Implementation
        implementation: {
            OP_implement: "@op/0000-cursor-rules/implement_core_rule_file",
            input: {
                "rule_request": "input.rule_request",
                "strategy": "M.strategy",
                "kb_artifacts": "M.artifact_journal.filter(a => a.artifact_type.startsWith('kb_'))",
                "rule_base_path": ".cursor/rules/"
            },
            output: "implementation_result",
            
            on_complete: [
                "M.artifact_journal = M.artifact_journal.concat(implementation_result.created_mdc_artifact)", 
                "Ω.transition(documentation)"
            ]
        },
        
        # Phase 5: Documentation Generation
        documentation: {
            OP_document: "@op/0000-cursor-rules/create_documentation",
            input: {
                "core_rule": "M.artifact_journal.find(a => a.artifact_type === 'rule_mdc')",
                "kb_artifacts": "M.artifact_journal.filter(a => a.artifact_type.startsWith('kb_'))",
                "rule_id": "input.rule_request.rule_id",
                "doc_manifest": "M.manifest.documentation_file"
            },
            output: "documentation_result",
            
            on_complete: [
                "M.artifact_journal = M.artifact_journal.concat(documentation_result.created_documentation_artifact)", 
                "Ω.transition(validation)"
            ]
        },
        
        # Phase 6: Validation
        validation: {
            OP_validate: "@op/0000-cursor-rules/validate_ecosystem",
            input: {
                "target_manifest": "M.manifest",
                "actual_journal": "M.artifact_journal",
                "validation_depth": "M.strategy.validation_depth"
            },
            output: "validation_report",
            
            on_complete: ["Ω.transition(finalization)"]
        },
        
        # Phase 7: Finalization
        finalization: {
            OP_finalize: "@op/0000-cursor-rules/finalize_creation",
            input: {
                "validation_report": "validation_report",
                "artifact_journal": "M.artifact_journal"
            },
            output: "final_output",
            
            on_complete: ["Ω.complete()"]
        }
    },

    output: {
        final_report: {
            status: "Final status of the rule creation process",
            validation_summary: "Summary of validation results",
            list_of_created_files: "Paths to all created files",
            link_to_documentation: "Path to the main documentation file"
        }
    },
    
    dependencies: {
        KB_config: "@kb/0000-cursor-rules/config/initial_kb_references",
        OP_assess: "@op/0000-cursor-rules/assess_complexity",
        OP_strategize: "@op/0000-cursor-rules/adapt_workflow_strategy",
        OP_clarify: "@op/0000-cursor-rules/request_clarification",
        OP_create_ecosystem: "@op/0000-cursor-rules/create_rule_ecosystem",
        OP_implement: "@op/0000-cursor-rules/implement_core_rule_file",
        OP_document: "@op/0000-cursor-rules/create_documentation",
        OP_validate: "@op/0000-cursor-rules/validate_ecosystem",
        OP_finalize: "@op/0000-cursor-rules/finalize_creation"
    }
}

Σ workflow•create_cursor_rule | M.sync(artifact_journal)
