# LLM Contract: Documentation Generator (Version 1.0.0)
# Generates documentation for a new rule and its ecosystem.

↹ llm_contract•documentation_generator [p=1] {
    id: "@llm_contract/0000-cursor-rules/documentation_generator",
    version: "1.0.0",
    description: "Generates comprehensive rule documentation with ecosystem overview",
    
    LLM_doc = {
        type: "documentation_generation",
        function: "generate_comprehensive_rule_docs",
        cognitive_load: "medium"
    }
    
    input: {
        rule_file: "Information about the core rule file (path, description, schemas)",
        kb_artifacts: "Array of KB artifacts created for this rule ecosystem",
        rule_id: "ID of the newly created rule",
        doc_structure: "Expected documentation structure and sections"
    },

    output: {
        content: "Generated Markdown documentation content",
        status: "enum(Success, SuccessWithPartialContent, GenerationFailed)",
        sections_covered: ["List of document sections covered in the output"]
    },
    
    prompt: {
        Π_sections: {
            context: """
            Ω_operation: Rule Documentation Generation
            
            You are tasked with generating comprehensive documentation (in Markdown format) 
            for the following rule and its ecosystem:
            
            Rule ID: {{rule_id}}
            """,
            
            rule_details: """
            # Core Rule Information
            Path: {{rule_file.file_path}}
            Description: {{rule_file.rule_description}}
            
            Input Schema: {{rule_file.input_schema_summary}}
            Output Schema: {{rule_file.output_schema_summary}}
            """,
            
            kb_ecosystem: """
            # Knowledge Base Ecosystem
            {{#each kb_artifacts}}
            - KB: {{this.file_path}}
              Type: {{this.artifact_type}}
              Purpose: {{this.kb_purpose}}
              {{#if this.content_summary}}Summary: {{this.content_summary}}{{/if}}
            {{/each}}
            """,
            
            structure_requirements: """
            # Documentation Requirements
            Required Sections: {{#join doc_structure ", "}}{{/join}}
            """,
            
            guidelines: """
            # Documentation Guidelines
            Your documentation MUST include these sections:
            1. Overview - What the rule does and its purpose
            2. Usage - How to use the rule (inputs, outputs, expected behavior)
            3. Dependencies - Rules or KBs it relies on
            4. Knowledge Base Ecosystem - Associated KBs with their roles
            5. All required sections specified in the structure requirements
            
            Format your output as clean, well-structured Markdown.
            Your entire response will be treated as the final documentation.
            """
        },
        
        template_assembly: "Π_sections.context + Π_sections.rule_details + Π_sections.kb_ecosystem + Π_sections.structure_requirements + Π_sections.guidelines"
    },
    
    model_config: {
        temperature: 0.4,
        top_p: 0.95,
        frequency_penalty: 0.0,
        presence_penalty: 0.0,
        response_format: "text"
    },
    
    Ψ_trace = {
        doc_requested: "M.record_doc_generation_request(rule_id)",
        sections_analyzed: "M.track_section_coverage(doc_structure, sections_covered)",
        doc_generated: "M.log_content_stats(content.length, status)"
    }
}

Σ llm_contract•documentation_generator | LLM_doc → content
