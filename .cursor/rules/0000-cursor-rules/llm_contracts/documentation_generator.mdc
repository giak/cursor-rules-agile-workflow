                        // Define specific properties, e.g., file_path, artifact_type, kb_purpose, content_summary
                    }
                },
                rule_id: { type: "string", description: "The main ID of the newly created rule (e.g., 0002-hello-world-semantic)." },
                target_documentation_manifest_entry: { 
                    type: "object", 
                    description: "Manifest entry detailing expected documentation structure or key sections."
                    // Define specific properties, e.g., target_path, main_sections_to_include
                }
            },
            required: ["core_rule_file_info", "rule_id", "target_documentation_manifest_entry"]
        }
    },

