# LLM Contract: KB Content Generator (Version 1.0.0)
# Generates content for a Knowledge Base file.

↹ llm_contract•kb_content_generator [p=1] {
    id: "@llm_contract/0000-cursor-rules/kb_content_generator",
    version: "1.0.0",
    description: "Generates specialized KB content based on purpose and context",
    
    LLM_kb = {
        type: "content_generation",
        function: "generate_kb_content_from_purpose",
        cognitive_load: "high"
    }
    
    input: {
        rule_request: "Original rule request details for context",
        kb_purpose: "Specific purpose of this KB component",
        key_points: "Array of key topics or structural elements to include"
    },

    output: {
        content: "Generated textual content for the KB file",
        status: "enum(Success, SuccessWithPartialContent, GenerationFailed)"
    },
    
    prompt: {
        Π_sections: {
            context: """
            Ω_operation: KB Content Generation
            
            You are tasked with generating content for a Knowledge Base (KB) file
            that will support the following rule creation:
            
            Rule Goal: {{rule_request.goal}}
            Rule Description: {{rule_request.description_detail}}
            """,
            
            task: """
            Generate specialized KB content for the following purpose:
            {{kb_purpose}}
            
            Your content MUST address these key points:
            {{#each key_points}}
            - {{this}}
            {{/each}}
            """,
            
            guidelines: """
            • Create comprehensive, well-structured content
            • Maintain appropriate technical depth
            • Use correct syntax for the KB type
            • Clearly define concepts and relationships
            • If any point cannot be fully addressed, indicate assumptions made
            """,
            
            output_format: """
            Return only the raw KB content, formatted appropriately for the context.
            Your entire response will be treated as the KB file content.
            """
        },
        
        template_assembly: "Π_sections.context + Π_sections.task + Π_sections.guidelines + Π_sections.output_format"
    },
    
    model_config: {
        temperature: 0.5,
        top_p: 0.95,
        frequency_penalty: 0.1,
        presence_penalty: 0.0,
        response_format: "text"
    },
    
    Ψ_trace = {
        request_sent: "M.record_kb_generation_request(kb_purpose)",
        response_quality: "Λ.assess_content_quality(content, key_points)",
        content_generated: "M.log_content_stats(content.length, status)"
    }
}

