# README Standards

↹ kb•readme•standards [p=1] {
  # Knowledge base paths
  ⊕ core_kb: ".cursor/kb/core/",
  ⊕ readme_kb: ".cursor/kb/1001-readme-standards/",
  
  # Standards and examples
  ⊕ structure_guide: readme_kb + "guidelines/structure_guide.md",
  ⊕ formatting_guide: readme_kb + "guidelines/formatting_guide.md",
  ⊕ examples: {
    good: readme_kb + "examples/good_examples.md",
    bad: readme_kb + "examples/bad_examples.md"
  },
  
  # Templates
  ⊕ readme_templates: readme_kb + "templates/",
  ⊕ project_types: {
    web_app: readme_templates + "web_app.md",
    library: readme_templates + "library.md",
    cli_tool: readme_templates + "cli_tool.md",
    api: readme_templates + "api.md"
  },
  
  # External references
  ⊕ markdown_guide: "https://www.markdownguide.org/",
  ⊕ badge_services: readme_kb + "references/badge_services.yaml"
}
